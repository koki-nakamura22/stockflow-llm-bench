+# --- state transition table ---
+# PENDING  -> CONFIRMED  (confirm)
+# CONFIRMED -> SHIPPED   (ship)
+# PENDING  -> CANCELED   (cancel)
+# CONFIRMED -> CANCELED  (cancel)
+# all other combinations -> 409 INVALID_ORDER_STATE
+
+_ALLOWED_TRANSITIONS: dict[str, set[str]] = {
+    "PENDING": {"CONFIRMED", "CANCELED"},
+    "CONFIRMED": {"SHIPPED", "CANCELED"},
+    "SHIPPED": set(),
+    "CANCELED": set(),
+}
+
+
+@app.post("/orders/{order_id}/confirm", response_model=OrderOut)
+def confirm_order(
+    order_id: uuid.UUID,
+    tenant: uuid.UUID = Depends(tenant_id),
+    session: Session = Depends(get_session),
+) -> Order:
+    try:
+        order = load_order(session, tenant, order_id, lock=True)
+        if order.status != "PENDING":
+            raise ApiError(409, "INVALID_ORDER_STATE", "Order cannot be confirmed")
+        order.status = "CONFIRMED"
+        session.commit()
+    except ApiError:
+        session.rollback()
+        raise
+    session.expire_all()
+    return load_order(session, tenant, order.id)
+
+
+@app.post("/orders/{order_id}/ship", response_model=OrderOut)
+def ship_order(
+    order_id: uuid.UUID,
+    tenant: uuid.UUID = Depends(tenant_id),
+    session: Session = Depends(get_session),
+) -> Order:
+    try:
+        order = load_order(session, tenant, order_id, lock=True)
+        if order.status != "CONFIRMED":
+            raise ApiError(409, "INVALID_ORDER_STATE", "Order cannot be shipped")
+        order.status = "SHIPPED"
+        session.commit()
+    except ApiError:
+        session.rollback()
+        raise
+    session.expire_all()
+    return load_order(session, tenant, order.id)
+
+
