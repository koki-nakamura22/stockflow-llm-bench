+from stockflow.schemas import Cursor, OrdersResponse, OrderCreate, OrderOut, ProductCreate, ProductOut
 
 app = FastAPI(title="StockFlow Mini")
+CURSOR_SECRET = os.environ.get("CURSOR_SECRET", "benchmark-public-secret")
