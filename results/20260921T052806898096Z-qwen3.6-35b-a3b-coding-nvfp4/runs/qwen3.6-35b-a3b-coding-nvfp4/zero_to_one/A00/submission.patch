+    tenant_id = request.state.tenant_id
+    now = datetime.now(timezone.utc)
+
+    with get_db_session() as db:
+        order = db.execute(
+            select(Order).where(
+                and_(Order.id == order_id, Order.tenant_id == tenant_id)
+            )
